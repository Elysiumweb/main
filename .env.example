# Elysium Web — exemple de configuration sans secret.
# Copier vers .env.local pour le développement local et remplacer les placeholders.

# Site public
REACT_APP_SITE_URL=https://elysium-esport.fr
REACT_APP_ENV=development
REACT_APP_VERSION=local

# Firebase Web App (valeurs publiques du projet Firebase, pas un secret serveur)
REACT_APP_FIREBASE_API_KEY=__replace_with_firebase_web_api_key__
REACT_APP_FIREBASE_AUTH_DOMAIN=__replace_with_project__.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=__replace_with_project__
REACT_APP_FIREBASE_STORAGE_BUCKET=__replace_with_project__.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=__replace_with_sender_id__
REACT_APP_FIREBASE_APP_ID=__replace_with_app_id__
REACT_APP_FIREBASE_MEASUREMENT_ID=
REACT_APP_FIREBASE_FUNCTIONS_REGION=us-central1

# App Check / anti-abus
REACT_APP_FIREBASE_APPCHECK_SITE_KEY=
REACT_APP_APPCHECK_DEBUG_TOKEN=
REACT_APP_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
ENFORCE_APP_CHECK=false

# Push web
REACT_APP_FIREBASE_VAPID_KEY=

# Paiement PayPal hébergé
REACT_APP_PAYPAL_CLIENT_ID=
REACT_APP_PAYPAL_HOSTED_BUTTON_ID=8R9PKMBPRB45N
REACT_APP_PAYPAL_SUBSCRIPTION_HOSTED_BUTTON_ID=

# Observabilité
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0.05
REACT_APP_SENTRY_REPLAY_SAMPLE_RATE=0
REACT_APP_SENTRY_REPLAY_ERROR_SAMPLE_RATE=0.1
REACT_APP_ANALYTICS_ENDPOINT=
REACT_APP_ANALYTICS_DEBUG=false

# Autorisations historiques — à remplacer progressivement par des custom claims.
REACT_APP_OFFICIAL_UID=
OFFICIAL_UID=

# Cloud Functions / emails. À injecter comme secrets Firebase en production.
APP_URL=https://elysium-esport.fr
FUNCTION_REGION=us-central1
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM=Elysium <noreply@elysium-esport.fr>

# CI / validation locale
SKIP_ENV_VALIDATION=false
