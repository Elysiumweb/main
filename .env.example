# Variables d'environnement (exemple)
# Copier vers .env.local / config Vercel / Netlify et renseigner les valeurs réelles.

# --- PayPal ---
REACT_APP_PAYPAL_HOSTED_BUTTON_ID="8R9PKMBPRB45N"
# Bouton d'abonnement (adhésion mensuelle) — créer dans le dashboard PayPal
# puis copier l'identifiant du bouton hébergé ici.
REACT_APP_PAYPAL_SUBSCRIPTION_HOSTED_BUTTON_ID=""

# --- Firebase ---
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
REACT_APP_FIREBASE_FUNCTIONS_REGION=us-central1

# --- Email (Resend ou Brevo) ---
MAIL_FROM="Elysium <noreply@elysium-esport.fr>"
RESEND_API_KEY=
BREVO_API_KEY=

# --- Discord OAuth (pour le login + liaison de compte) ---
REACT_APP_DISCORD_CLIENT_ID=
REACT_APP_DISCORD_CLIENT_SECRET=
