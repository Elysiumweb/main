# Variables d'environnement (exemple)
# Copier vers .env.local / config Vercel / Netlify et renseigner les valeurs réelles.

# --- PayPal ---
REACT_APP_PAYPAL_HOSTED_BUTTON_ID="8R9PKMBPRB45N"
# Bouton d'abonnement (adhésion mensuelle) — créer dans le dashboard PayPal
# puis copier l'identifiant du bouton hébergé ici.
REACT_APP_PAYPAL_SUBSCRIPTION_HOSTED_BUTTON_ID=""

# --- Firebase ---
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
REACT_APP_FIREBASE_FUNCTIONS_REGION=us-central1

# --- Email (Resend ou Brevo) ---
MAIL_FROM="Elysium <noreply@elysium-esport.fr>"
RESEND_API_KEY=
BREVO_API_KEY=

# --- Discord OAuth (pour le login + liaison de compte) ---
REACT_APP_DISCORD_CLIENT_ID=
REACT_APP_DISCORD_CLIENT_SECRET=

# --- Analytics ---
# Destination HTTP optionnelle (en plus de la collection Firestore `analytics_events`).
REACT_APP_ANALYTICS_ENDPOINT=
REACT_APP_ANALYTICS_DEBUG=false
# Mettre à false pour couper uniquement l'écriture Firestore.
REACT_APP_ANALYTICS_FIRESTORE=true

# --- Feature flags / staging ---
# Surcharges locales des drapeaux stockés dans `featureFlags` (JSON).
# Exemple : {"recruitmentOpen":false,"donationsEnabled":true}
REACT_APP_FEATURE_FLAGS=
# true = bandeau « préproduction » + meta robots noindex.
REACT_APP_STAGING=false

# --- Amorçage du compte officiel ---
# Uniquement pour la transition : les règles Firestore ne lisent plus cet UID.
# Créer `config/officials` = { uids: ["<uid>"] } ou `users/<uid>.official = true`.
REACT_APP_OFFICIAL_UID=
