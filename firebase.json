{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/calendar.ics", "function": "calendarFeed" },
      { "source": "/api/paypal-webhook", "function": "paypalWebhook" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "/api/calendar.ics", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
    ]
  }
}
