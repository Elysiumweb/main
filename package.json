  "scripts": {
    "start": "craco start",
    "prebuild": "npm run env:check && node scripts/generate-sitemap.mjs",
    "build": "craco build",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "test": "craco test",
    "test:e2e": "playwright test",
    "test:lighthouse": "npx lighthouse http://127.0.0.1:3000 --preset=desktop --view",
    "ics": "node scripts/generate-ics.mjs",
    "env:check": "node scripts/validate-env.mjs --mode=build",
    "env:example": "node scripts/validate-env.mjs --mode=example",
    "lint": "eslint src scripts tests --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.checkjs.json",
    "test:unit": "craco test --watchAll=false",
    "test:rules:unit": "node tests/firebase/firestore-rules.test.cjs",
    "test:rules": "npx --yes firebase-tools@13.35.1 emulators:exec --project demo-elysium-rules-test --only firestore,storage \"npm run test:rules:unit\"",
    "verify:seo": "node scripts/verify-seo-feeds.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "postbuild": "node scripts/prerender-public.mjs && npm run bundle:budget && npm run verify:seo && npm run verify:assets",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "audit:functions": "npm audit --prefix functions --omit=dev --audit-level=high"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
