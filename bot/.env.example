# ============================================================================
# Bot Discord Elysium — Variables d'environnement
# Copiez ce fichier vers `bot/.env` et renseignez vos identifiants.
# ============================================================================

# Token du bot Discord (obligatoire — à régénérer avant la mise en production)
DISCORD_TOKEN=

# Client ID de l'application Discord (optionnel : déduit automatiquement du token si vide)
DISCORD_CLIENT_ID=

# URL publique du site Elysium (utilisée pour les liens vers les fiches matchs / joueurs)
SITE_URL=https://elysium-esport.fr

# Fuseau horaire pour l'interprétation des heures saisies dans /ask-result
BOT_TIMEZONE=Europe/Paris

# Lien de donation envoyé à la clôture d'un ticket accepté
DONATION_URL=https://www.paypal.com/ncp/payment/8R9PKMBPRB45N

# --- Connexion Firebase Firestore (reliée au site Elysium) ---
# Méthode 1 (la plus simple en local / VPS) :
#   Téléchargez la clé privée JSON depuis la Console Firebase :
#   Paramètres du projet → Comptes de service → Générer une nouvelle clé privée
#   et déposez le fichier sous `bot/serviceAccountKey.json` (détecté automatiquement).
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Méthode 2 (hébergeur cloud type Railway / Render / Discloud sans fichier local) :
#   Collez le JSON complet sur une seule ligne (ou encodé en base64) :
FIREBASE_SERVICE_ACCOUNT_JSON=
