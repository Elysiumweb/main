rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Compte officiel Elysium =====
    function isOfficial() {
      return request.auth != null && request.auth.uid == '9IzGlpp6DHhrN9GW72haeb869Om1';
    }

    function isAuth() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function userGame() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.game;
    }

    function userRoster() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roster;
    }

    function hasPlayerAccess() {
      return isAuth() && (isOfficial() || userRole() in ['player', 'manager', 'bureau']);
    }

    function isBureau() {
      return isAuth() && (isOfficial() || userRole() == 'bureau');
    }

    function isManagerPlus() {
      return isAuth() && (isOfficial() || userRole() in ['manager', 'bureau']);
    }

    function isValidRole(role) {
      return role in ['visitor', 'player', 'manager', 'bureau'];
    }

    function publicWriteThrottleFields() {
      return request.resource.data.keys().hasOnly(['name', 'company', 'email', 'budget', 'message', 'createdAt'])
        || request.resource.data.keys().hasOnly(['email', 'confirmed', 'confirmToken', 'lang', 'subscribedAt', 'consentGivenAt']);
    }

    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    // ===== Preuve MFA côté serveur =====
    // La doc mfaSessions/{uid} est écrite UNIQUEMENT par la Cloud Function
    // verifyMfaSession après vérification serveur du code TOTP. Les opérations
    // sensibles (administration, changement de rôle…) exigent une session MFA
    // datant de moins de 6 heures — un contournement de l'interface ne suffit
    // plus : sans vérification serveur récente, la règle refuse.
    function mfaSessionRecent() {
      return isAuth()
        && exists(/databases/$(database)/documents/mfaSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/mfaSessions/$(request.auth.uid)).data.verifiedAt.seconds > request.time.seconds - 21600;
    }

    // ===== Canaux de chat : pôle / roster du membre =====
    // Les canaux sont nommés game_<jeu>, roster_<roster> ou global. Un membre
    // n'accède qu'à : son pôle, son roster, le canal global. Le filtrage n'est
    // plus fait côté React : il est imposé par les règles (SDK et API REST).
    function canReadChannel(channel) {
      return isOfficial()
        || channel == 'global'
        || channel == 'game_' + userGame()
        || (userRoster() is string && channel == 'roster_' + userRoster());
    }

    function canModerateChannel(channel) {
      return isBureau()
        || (userRole() == 'manager'
            && (channel == 'game_' + userGame()
                || (userRoster() is string && channel == 'roster_' + userRoster())));
    }

    // ===== Utilisateurs =====
    // Secrets TOTP applicatifs (plan Spark : pas d'Identity Platform).
    // Lecture/écriture uniquement par le propriétaire — jamais par le staff.
    match /mfaSecrets/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    // Sessions MFA vérifiées côté serveur : lecture par le propriétaire,
    // écriture réservée à la Cloud Function (compte de service).
    match /mfaSessions/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /users/{uid} {
      // Un joueur lit uniquement son propre profil privé. Managers/bureau lisent
      // la collection pour le planning d'équipe et l'administration des rôles.
      allow read: if isAuth() && (request.auth.uid == uid || isManagerPlus());

      allow create: if isAuth() && request.auth.uid == uid
        && request.resource.data.role == 'visitor'
        && request.resource.data.game == null
        && (!request.resource.data.keys().hasAny(['roster']) || request.resource.data.roster == null);

      // Rôles validés côté règles. Les utilisateurs ne peuvent jamais s'auto-promouvoir
      // ni changer leur pôle/roster : séparation stricte joueur/staff côté serveur.
      // Le compte officiel doit disposer d'une session MFA récente (côté serveur).
      allow update: if (isOfficial()
          && mfaSessionRecent()
          && isValidRole(request.resource.data.role)
          && (!request.resource.data.keys().hasAny(['game']) || request.resource.data.game == null || request.resource.data.game in ['EVA', 'Rocket League', 'Valorant'])
          && (!request.resource.data.keys().hasAny(['roster']) || request.resource.data.roster == null || request.resource.data.roster is string))
        // Auto-mise à jour SANS toucher aux champs sensibles (photo, email,
        // totpEnabled…) : aucune lecture de clé manquante.
        || (request.auth.uid == uid
            && !request.resource.data.keys().hasAny(['role', 'game', 'roster']))
        // Auto-mise à jour en renvoyant explicitement role/game/roster à
        // l'identique (profil) : aucun changement de rôle possible.
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.game == resource.data.game
            && request.resource.data.roster == resource.data.roster);

      allow delete: if isOfficial() && mfaSessionRecent();
    }

    // ===== Annuaire joueurs (espace privé) =====
    // Copie minimale et publique-entre-joueurs du profil : uid, displayName,
    // game, roster, photoURL. Sert aux @mentions du chat et à l'indicateur
    // « absent aujourd'hui » côté staff. Aucune donnée sensible (pas d'email).
    match /profiles/{uid} {
      allow read: if hasPlayerAccess();
      allow create, update: if isAuth() && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && (!request.resource.data.keys().hasAny(['displayName']) || isShortString(request.resource.data.displayName, 60))
        && (!request.resource.data.keys().hasAny(['photoURL'])
            || request.resource.data.photoURL is string
            || request.resource.data.photoURL == null);
      allow delete: if isAuth() && request.auth.uid == uid;
    }

    // ===== Roster public =====
    match /roster/{id} {
      allow read: if true;
      allow create, update, delete: if isBureau() && mfaSessionRecent();
    }

    // ===== Postes =====
    match /positions/{id} {
      allow read: if true;
      allow create, update, delete: if isManagerPlus() && mfaSessionRecent();
    }

    // ===== Matchs =====
    match /matches/{id} {
      allow read: if true;
      allow create, update, delete: if isOfficial() && mfaSessionRecent();
    }

    // ===== Chats (game + roster + global) =====
    // Channels: game_EVA, game_Rocket League, game_Valorant, roster_Espoir, roster_Académique,
    // roster_Esport, roster_Junior, roster_Valeureux, roster_Vaillant, global
    match /chats/{channel}/messages/{id} {
      allow read: if hasPlayerAccess() && canReadChannel(channel);
      allow create: if hasPlayerAccess() && canReadChannel(channel)
        && request.resource.data.uid == request.auth.uid
        && isShortString(request.resource.data.text, 2000)
        && (!request.resource.data.keys().hasAny(['image'])
            || isShortString(request.resource.data.image, 2000))
        && (!request.resource.data.keys().hasAny(['mentions'])
            || request.resource.data.mentions is list
            && request.resource.data.mentions.size() <= 20);
      // Un joueur peut modifier/supprimer SON PROPRE message (édition, retrait
      // d'une image, mention). Le bureau (officiel) reste modérateur global.
      allow update: if hasPlayerAccess() && canReadChannel(channel)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && isShortString(request.resource.data.text, 2000)
        && (!request.resource.data.keys().hasAny(['image'])
            || request.resource.data.image is string);
      allow delete: if isOfficial()
        || (hasPlayerAccess() && canReadChannel(channel) && resource.data.uid == request.auth.uid)
        || canModerateChannel(channel);
    }

    // ===== Planning =====
    match /events/{id} {
      allow read: if hasPlayerAccess();
      allow create, delete: if isManagerPlus();
      allow update: if isManagerPlus()
        || (hasPlayerAccess() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendance']));
    }

    // ===== Disponibilités (exceptions hebdomadaires) =====
    // Legacy docs store the full hours list. New docs store delta lists
    // (added/removed) applied on top of the recurring weekly template.
    match /availabilities/{id} {
      allow read: if hasPlayerAccess();
      allow create, update: if hasPlayerAccess()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.date is string
        && (!request.resource.data.keys().hasAny(['hours'])
            || request.resource.data.hours is list)
        && (!request.resource.data.keys().hasAny(['added'])
            || request.resource.data.added is list)
        && (!request.resource.data.keys().hasAny(['removed'])
            || request.resource.data.removed is list);
      allow delete: if isAuth() && (resource.data.uid == request.auth.uid || isManagerPlus());
    }

    // ===== Disponibilités récurrentes (semaine type, appliquée chaque semaine) =====
    match /recurringAvailabilities/{id} {
      allow read: if hasPlayerAccess();
      allow create, update: if hasPlayerAccess()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.days is map;
      allow delete: if isAuth() && (resource.data.uid == request.auth.uid || isManagerPlus());
    }

    // ===== Absences déclarées =====
    match /absences/{id} {
      allow read: if hasPlayerAccess();
      allow create, update: if hasPlayerAccess()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.date is string
        && (!request.resource.data.keys().hasAny(['reason']) || isShortString(request.resource.data.reason, 120));
      allow delete: if isAuth() && (resource.data.uid == request.auth.uid || isManagerPlus());
    }

    // ===== Actualités =====
    match /articles/{id} {
      allow read: if resource.data.status == 'published' || isBureau();
      allow create, update, delete: if isBureau() && mfaSessionRecent();
    }

    // ===== Médiathèque =====
    match /media/{id} {
      allow read: if true;
      allow create, update, delete: if isBureau() && mfaSessionRecent();
    }

    // ===== Calendrier communautaire =====
    // RSVP « je participe » : tout visiteur (connecté ou non) peut mettre à jour
    // UNIQUEMENT la liste des participants. Le reste de l'événement reste
    // réservé aux managers. Validation possible sans itération : liste +
    // taille plafonnée (le langage des règles ne permet pas de typer chaque
    // élément — la validation fine est faite côté application).
    match /communityEvents/{id} {
      allow read: if true;
      allow create, delete: if isManagerPlus();
      allow update: if isManagerPlus()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
            && request.resource.data.participants is list
            && request.resource.data.participants.size() <= 500);
    }

    // ===== Compétitions (page /competitions) =====
    match /competitions/{id} {
      allow read: if true;
      allow create, update, delete: if isBureau() && mfaSessionRecent();
    }

    // ===== Campagnes / objectifs de financement (barre de progression) =====
    // Données saisies manuellement en admin (comptabilité de l'association).
    match /campaigns/{id} {
      allow read: if true;
      allow create, update, delete: if isBureau() && mfaSessionRecent();
    }

    // ===== Notifications =====
    // Lecture : uniquement le destinataire réel — cible directe (targetUid),
    // rôle visé (targetRoles) ou utilisateur ayant déjà marqué la notification
    // comme lue (readBy). Un joueur EVA ne voit pas les notifications ciblées
    // sur un autre pôle (targetGame).
    match /notifications/{id} {
      allow read: if isAuth() && (
        resource.data.targetUid == request.auth.uid
        || (resource.data.targetRoles is list
            && resource.data.targetRoles.hasAny([userRole()]))
        || (resource.data.readBy is list
            && resource.data.readBy.hasAny([request.auth.uid]))
      ) && (isOfficial()
            || !resource.data.keys().hasAny(['targetGame'])
            || resource.data.targetGame == 'global'
            || resource.data.targetGame == userGame());

      // Création : réservée aux actions métier précisément autorisées (mention
      // chat vers un autre membre, rappel de match sur soi-même). Toutes les
      // autres notifications (event_new, support_new, thread_reply…) passent
      // par la Cloud Function `createNotification` qui valide l'auteur.
      allow create: if isAuth() && (
        (request.resource.data.type == 'chat_mention'
          && request.resource.data.targetUid is string
          && request.resource.data.targetUid != request.auth.uid
          && !request.resource.data.keys().hasAny(['targetRoles', 'targetGame']))
        || (request.resource.data.type == 'match_reminder'
          && request.resource.data.targetUid == request.auth.uid
          && !request.resource.data.keys().hasAny(['targetRoles', 'targetGame']))
      ) && request.resource.data.readBy is list
        && request.resource.data.readBy.size() == 0
        && isShortString(request.resource.data.extra, 300)
        && isShortString(request.resource.data.link, 300);

      // Mise à jour : uniquement « marquer comme lu » (readBy) par le
      // destinataire — jamais la cible, le type ou le contenu. Le bureau peut
      // nettoyer (ex : notification obsolète) avec une session MFA récente.
      allow update: if isAuth() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasAny([request.auth.uid])
          && request.resource.data.readBy.size()
             <= (resource.data.readBy is list ? resource.data.readBy.size() : 0) + 1)
        || isBureau()
      );

      allow delete: if isBureau() && mfaSessionRecent();
    }

    // ===== Jetons push FCM Web =====
    match /pushTokens/{id} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow create, update: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.enabled is bool
        && isShortString(request.resource.data.token, 500);
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ===== Demandes de suppression RGPD =====
    match /accountDeletionRequests/{uid} {
      allow create, update, read: if isAuth() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ===== Logs d'envoi newsletter =====
    match /newsletterDigestLogs/{id} {
      allow read: if isBureau() && mfaSessionRecent();
      allow create, update, delete: if false;
    }

    // ===== Journal d'activité =====
    // Chaque entrée porte un `game` (pôle ou 'global') : un membre ne voit que
    // son pôle et le canal global. Le filtrage est imposé par les règles.
    match /activity/{id} {
      allow read: if hasPlayerAccess()
        && (isOfficial() || resource.data.game == userGame() || resource.data.game == 'global');
      allow create: if hasPlayerAccess()
        && (request.resource.data.game == userGame() || request.resource.data.game == 'global')
        && isShortString(request.resource.data.type, 60)
        && isShortString(request.resource.data.label, 200);
      allow delete: if isBureau() && mfaSessionRecent();
    }

    // ===== Journal d'audit admin / modération =====
    // La création reste ouverte aux managers+ (journalisation de la
    // modération du chat) ; la lecture/consultation est réservée au bureau
    // avec session MFA récente.
    match /admin_audit/{id} {
      allow read: if isBureau() && mfaSessionRecent();
      allow create: if isManagerPlus();
      allow update: if false;
      allow delete: if isBureau() && mfaSessionRecent();
    }

    // ===== Notes =====
    // La suppression est douce : on pose `deletedAt` (corbeille 30 jours).
    // La restauration efface ce champ. Les versions sont stockées dans une
    // sous-collection `versions` (historique) avec le même contrôle d'accès.
    match /notes/{id} {
      allow read: if hasPlayerAccess()
        && (resource.data.type == 'collective' || resource.data.ownerUid == request.auth.uid);
      allow create: if hasPlayerAccess() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if hasPlayerAccess()
        && (resource.data.type == 'collective' || resource.data.ownerUid == request.auth.uid);

      match /versions/{vid} {
        allow read: if hasPlayerAccess()
          && (get(/databases/$(database)/documents/notes/$(id)).data.type == 'collective'
              || get(/databases/$(database)/documents/notes/$(id)).data.ownerUid == request.auth.uid);
        allow create: if hasPlayerAccess()
          && request.resource.data.uid == request.auth.uid;
        allow delete: if hasPlayerAccess();
      }
    }

    // ===== Canvas =====
    // Chaque tableau porte un `game` : un membre ne voit que les tableaux de
    // son pôle (l'officiel voit tout). La création impose le pôle du membre —
    // impossible de créer un tableau « privé » d'un autre pôle.
    match /canvases/{id} {
      allow read: if hasPlayerAccess() && (isOfficial() || resource.data.game == userGame());
      allow create: if hasPlayerAccess()
        && request.resource.data.game == userGame()
        && isShortString(request.resource.data.title, 120)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasPlayerAccess()
        && (isOfficial() || resource.data.game == userGame())
        && (isOfficial() || resource.data.createdBy == request.auth.uid
            || userRole() == 'manager');
      allow delete: if hasPlayerAccess()
        && (isOfficial() || (resource.data.game == userGame() && resource.data.createdBy == request.auth.uid));
    }

    // ===== Support =====
    match /supportThreads/{id} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isBureau());
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && isShortString(request.resource.data.subject, 140)
        && isShortString(request.resource.data.meta, 4000);
      allow update: if isBureau()
        || (isAuth() && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.status == resource.data.status);
      allow delete: if isBureau();

      match /messages/{mid} {
        allow read: if isAuth()
          && (get(/databases/$(database)/documents/supportThreads/$(id)).data.uid == request.auth.uid || isBureau());
        allow create: if isAuth()
          && (get(/databases/$(database)/documents/supportThreads/$(id)).data.uid == request.auth.uid || isBureau())
          && request.resource.data.uid == request.auth.uid
          && isShortString(request.resource.data.text, 4000);
      }
    }

    // ===== Partenaires =====
    match /partners/{id} {
      allow read: if true;
      allow create, update, delete: if isBureau() && mfaSessionRecent();
    }

    // ===== Demandes de partenariat =====
    match /partner_requests/{id} {
      // Public form: field allow-list, mandatory timestamp and length caps to reduce spam/abuse.
      allow create: if publicWriteThrottleFields()
        && request.resource.data.createdAt == request.time
        && isShortString(request.resource.data.name, 120)
        && isShortString(request.resource.data.company, 160)
        && isShortString(request.resource.data.email, 180)
        && isShortString(request.resource.data.message, 3000);
      allow read, update, delete: if isBureau() && mfaSessionRecent();
    }

    // ===== Newsletter =====
    // Lecture/écriture jamais publiques : l'inscription se fait par create
    // limité (double opt-in), la confirmation et la désinscription par Cloud
    // Functions à jeton. Le formulaire public n'interroge JAMAIS cette
    // collection : il passe par `requestNewsletterUnsubscribe` (callable).
    match /newsletter/{id} {
      allow read: if isBureau() && mfaSessionRecent();
      allow create: if publicWriteThrottleFields()
        && request.resource.data.confirmed == false
        && request.resource.data.subscribedAt == request.time
        && request.resource.data.consentGivenAt == request.time
        && isShortString(request.resource.data.email, 180)
        && isShortString(request.resource.data.confirmToken, 160);
      allow update: if isBureau() && mfaSessionRecent();
      allow delete: if isBureau() && mfaSessionRecent();
    }

    // ===== Rappels de match (planifiés côté serveur) =====
    // Écriture réservée à la Cloud Function `scheduleMatchReminder`
    // (compte de service) — jamais par le client directement.
    match /matchReminders/{id} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ===== Recrutement =====
    match /recruitThreads/{id} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isManagerPlus());
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time
        && isShortString(request.resource.data.position, 140)
        && isShortString(request.resource.data.meta, 4000);
      allow update: if isManagerPlus()
        || (isAuth() && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.status == resource.data.status);
      allow delete: if isManagerPlus();

      match /messages/{mid} {
        allow read: if isAuth()
          && (get(/databases/$(database)/documents/recruitThreads/$(id)).data.uid == request.auth.uid || isManagerPlus());
        allow create: if isAuth()
          && (get(/databases/$(database)/documents/recruitThreads/$(id)).data.uid == request.auth.uid || isManagerPlus())
          && request.resource.data.uid == request.auth.uid
          && isShortString(request.resource.data.text, 4000);
      }
    }
  }
}
