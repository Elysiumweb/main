rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Compte officiel Elysium =====
    function isOfficial() {
      return request.auth != null && request.auth.uid == '9IzGlpp6DHhrN9GW72haeb869Om1';
    }

    function isAuth() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function userGame() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.game;
    }

    function userRoster() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roster;
    }

    function hasPlayerAccess() {
      return isAuth() && (isOfficial() || userRole() in ['player', 'manager', 'bureau']);
    }

    function isBureau() {
      return isAuth() && (isOfficial() || userRole() == 'bureau');
    }

    function isManagerPlus() {
      return isAuth() && (isOfficial() || userRole() in ['manager', 'bureau']);
    }

    function isValidRole(role) {
      return role in ['visitor', 'player', 'manager', 'bureau'];
    }

    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    // ===== Utilisateurs =====
    // Secrets TOTP applicatifs (plan Spark : pas d'Identity Platform).
    // Lecture/écriture uniquement par le propriétaire — jamais par le staff.
    match /mfaSecrets/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Un joueur lit uniquement son propre profil privé. Managers/bureau lisent
      // la collection pour le planning d'équipe et l'administration des rôles.
      allow read: if isAuth() && (request.auth.uid == uid || isManagerPlus());

      allow create: if isAuth() && request.auth.uid == uid
        && request.resource.data.role == 'visitor'
        && request.resource.data.game == null
        && (!request.resource.data.keys().hasAny(['roster']) || request.resource.data.roster == null);

      // Rôles validés côté règles. Les utilisateurs ne peuvent jamais s'auto-promouvoir
      // ni changer leur pôle/roster : séparation stricte joueur/staff côté serveur.
      allow update: if (isOfficial()
          && isValidRole(request.resource.data.role)
          && (!request.resource.data.keys().hasAny(['game']) || request.resource.data.game == null || request.resource.data.game in ['EVA', 'Rocket League', 'Valorant'])
          && (!request.resource.data.keys().hasAny(['roster']) || request.resource.data.roster == null || request.resource.data.roster is string))
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.game == resource.data.game
            && request.resource.data.roster == resource.data.roster);

      allow delete: if isOfficial() || request.auth.uid == uid;
    }

    // ===== Annuaire joueurs (espace privé) =====
    // Copie minimale et publique-entre-joueurs du profil : uid, displayName,
    // game, roster, photoURL. Sert aux @mentions du chat et à l'indicateur
    // « absent aujourd'hui » côté staff. Aucune donnée sensible (pas d'email).
    match /profiles/{uid} {
      allow read: if hasPlayerAccess();
      allow create, update: if isAuth() && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && (!request.resource.data.keys().hasAny(['displayName']) || isShortString(request.resource.data.displayName, 60))
        && (!request.resource.data.keys().hasAny(['photoURL'])
            || request.resource.data.photoURL is string
            || request.resource.data.photoURL == null);
      allow delete: if isAuth() && request.auth.uid == uid;
    }

    // ===== Roster public =====
    match /roster/{id} {
      allow read: if true;
      allow create, update, delete: if isBureau();
    }

    // ===== Postes =====
    match /positions/{id} {
      allow read: if true;
      allow create, update, delete: if isManagerPlus();
    }

    // ===== Matchs =====
    match /matches/{id} {
      allow read: if true;
      allow create, update, delete: if isOfficial();
    }

    // ===== Chats (game + roster + global) =====
    // Channels: game_EVA, game_Rocket League, game_Valorant, roster_Espoir, roster_Académique,
    // roster_Esport, roster_Junior, roster_Valeureux, roster_Vaillant, global
    match /chats/{channel}/messages/{id} {
      allow read: if hasPlayerAccess();
      allow create: if hasPlayerAccess()
        && request.resource.data.uid == request.auth.uid
        && isShortString(request.resource.data.text, 2000)
        && (!request.resource.data.keys().hasAny(['image'])
            || isShortString(request.resource.data.image, 2000));
      // Un joueur peut modifier/supprimer SON PROPRE message (édition, retrait
      // d'une image, mention). Le bureau (officiel) reste modérateur global.
      allow update: if hasPlayerAccess()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && isShortString(request.resource.data.text, 2000)
        && (!request.resource.data.keys().hasAny(['image'])
            || request.resource.data.image is string);
      allow delete: if isOfficial()
        || (hasPlayerAccess() && resource.data.uid == request.auth.uid)
        || isBureau()
        || (isAuth() && userRole() == 'manager'
            && (channel == 'game_' + userGame()
                || (userRoster() is string && channel == 'roster_' + userRoster())));
    }

    // ===== Planning =====
    match /events/{id} {
      allow read: if hasPlayerAccess();
      allow create, delete: if isManagerPlus();
      allow update: if isManagerPlus()
        || (hasPlayerAccess() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendance']));
    }

    // ===== Disponibilités (exceptions hebdomadaires) =====
    // Legacy docs store the full hours list. New docs store delta lists
    // (added/removed) applied on top of the recurring weekly template.
    match /availabilities/{id} {
      allow read: if hasPlayerAccess();
      allow create, update: if hasPlayerAccess()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.date is string
        && (!request.resource.data.keys().hasAny(['hours'])
            || request.resource.data.hours is list)
        && (!request.resource.data.keys().hasAny(['added'])
            || request.resource.data.added is list)
        && (!request.resource.data.keys().hasAny(['removed'])
            || request.resource.data.removed is list);
      allow delete: if isAuth() && (resource.data.uid == request.auth.uid || isManagerPlus());
    }

    // ===== Disponibilités récurrentes (semaine type, appliquée chaque semaine) =====
    match /recurringAvailabilities/{id} {
      allow read: if hasPlayerAccess();
      allow create, update: if hasPlayerAccess()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.days is map;
      allow delete: if isAuth() && (resource.data.uid == request.auth.uid || isManagerPlus());
    }

    // ===== Absences déclarées =====
    match /absences/{id} {
      allow read: if hasPlayerAccess();
      allow create, update: if hasPlayerAccess()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.date is string
        && (!request.resource.data.keys().hasAny(['reason']) || isShortString(request.resource.data.reason, 120));
      allow delete: if isAuth() && (resource.data.uid == request.auth.uid || isManagerPlus());
    }

    // ===== Actualités =====
    match /articles/{id} {
      allow read: if resource.data.status == 'published' || isBureau();
      allow create, update, delete: if isBureau();
    }

    // ===== Médiathèque =====
    match /media/{id} {
      allow read: if true;
      allow create, update, delete: if isBureau();
    }

    // ===== Calendrier communautaire =====
    // RSVP « je participe » : passe exclusivement par la Cloud Function
    // transactionnelle `rsvpCommunityEvent` (Admin SDK), qui garantit qu'un
    // visiteur ne modifie QUE sa propre participation (jeton secret pour les
    // anonymes, uid pour les connectés). Plus aucune écriture publique directe
    // du tableau `participants`.
    match /communityEvents/{id} {
      allow read: if true;
      allow create, delete: if isManagerPlus();
      allow update: if isManagerPlus();

      // Preuves de participation (hash de jeton) écrites par la Function.
      match /rsvps/{pid} {
        allow read: if isManagerPlus();
        allow write: if false;
      }
    }

    // ===== Compétitions (page /competitions) =====
    match /competitions/{id} {
      allow read: if true;
      allow create, update, delete: if isBureau();
    }

    // ===== Campagnes / objectifs de financement (barre de progression) =====
    // Données saisies manuellement en admin (comptabilité de l'association).
    match /campaigns/{id} {
      allow read: if true;
      allow create, update, delete: if isBureau();
    }

    // ===== Notifications =====
    match /notifications/{id} {
      allow read, create, update: if isAuth();
      allow delete: if isBureau();
    }

    // ===== Jetons push FCM Web =====
    match /pushTokens/{id} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow create, update: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.enabled is bool
        && isShortString(request.resource.data.token, 500);
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ===== Demandes de suppression RGPD =====
    match /accountDeletionRequests/{uid} {
      allow create, update, read: if isAuth() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ===== Logs d'envoi newsletter =====
    match /newsletterDigestLogs/{id} {
      allow read: if isBureau();
      allow create, update, delete: if false;
    }

    // ===== Journal d'activité =====
    match /activity/{id} {
      allow read, create: if hasPlayerAccess();
      allow delete: if isBureau();
    }

    // ===== Journal d'audit admin / modération =====
    match /admin_audit/{id} {
      allow read: if isBureau();
      allow create: if isManagerPlus();
      allow update: if false;
      allow delete: if isBureau();
    }

    // ===== Notes =====
    // La suppression est douce : on pose `deletedAt` (corbeille 30 jours).
    // La restauration efface ce champ. Les versions sont stockées dans une
    // sous-collection `versions` (historique) avec le même contrôle d'accès.
    match /notes/{id} {
      allow read: if hasPlayerAccess()
        && (resource.data.type == 'collective' || resource.data.ownerUid == request.auth.uid);
      allow create: if hasPlayerAccess() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if hasPlayerAccess()
        && (resource.data.type == 'collective' || resource.data.ownerUid == request.auth.uid);

      match /versions/{vid} {
        allow read: if hasPlayerAccess()
          && (get(/databases/$(database)/documents/notes/$(id)).data.type == 'collective'
              || get(/databases/$(database)/documents/notes/$(id)).data.ownerUid == request.auth.uid);
        allow create: if hasPlayerAccess()
          && request.resource.data.uid == request.auth.uid;
        allow delete: if hasPlayerAccess();
      }
    }

    // ===== Canvas =====
    match /canvases/{id} {
      allow read, create, update, delete: if hasPlayerAccess();
    }

    // ===== Support =====
    match /supportThreads/{id} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isBureau());
      // Création exclusivement via la Cloud Function `submitSupportTicket`
      // (quotas par compte/IP, CAPTCHA adaptatif, validation serveur).
      allow create: if false;
      allow update: if isBureau()
        || (isAuth() && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.status == resource.data.status);
      allow delete: if isBureau();

      match /messages/{mid} {
        allow read: if isAuth()
          && (get(/databases/$(database)/documents/supportThreads/$(id)).data.uid == request.auth.uid || isBureau());
        allow create: if isAuth()
          && (get(/databases/$(database)/documents/supportThreads/$(id)).data.uid == request.auth.uid || isBureau())
          && request.resource.data.uid == request.auth.uid
          && isShortString(request.resource.data.text, 4000);
      }
    }

    // ===== Partenaires =====
    match /partners/{id} {
      allow read: if true;
      allow create, update, delete: if isBureau();
    }

    // ===== Demandes de partenariat =====
    match /partner_requests/{id} {
      // Formulaire public : création exclusivement via la Cloud Function
      // `submitPartnerRequest` (App Check, quotas IP, CAPTCHA adaptatif,
      // validation des champs côté serveur). Plus d'écriture directe client.
      allow create: if false;
      allow read, update, delete: if isBureau();
    }

    // ===== Newsletter =====
    match /newsletter/{id} {
      allow read: if isBureau();
      // Inscription / désinscription exclusivement via les Cloud Functions
      // `subscribeNewsletter` et `requestNewsletterUnsubscribe` (quotas par IP,
      // CAPTCHA adaptatif, jeton généré côté serveur, pas d'énumération).
      allow create: if false;
      allow update: if isBureau();
      allow delete: if isBureau();
    }

    // ===== Recrutement =====
    match /recruitThreads/{id} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isManagerPlus());
      // Création exclusivement via la Cloud Function `submitRecruitApplication`
      // (quotas, CAPTCHA adaptatif, validation serveur et parcours de
      // consentement parental vérifié par email pour les moins de 15 ans).
      allow create: if false;
      allow update: if isManagerPlus()
        || (isAuth() && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.status == resource.data.status);
      allow delete: if isManagerPlus();

      match /messages/{mid} {
        allow read: if isAuth()
          && (get(/databases/$(database)/documents/recruitThreads/$(id)).data.uid == request.auth.uid || isManagerPlus());
        allow create: if isAuth()
          && (get(/databases/$(database)/documents/recruitThreads/$(id)).data.uid == request.auth.uid || isManagerPlus())
          && request.resource.data.uid == request.auth.uid
          && isShortString(request.resource.data.text, 4000);
      }
    }

    // ===== Compteurs de quotas anti-abus (Cloud Functions uniquement) =====
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // ===== Archives anonymisées (rétention 24 mois, Cloud Functions) =====
    match /archivedThreads/{id} {
      allow read: if isBureau();
      allow write: if false;
    }
  }
}
