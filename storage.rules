rules_version = '2';

// ===========================================================================
// Règles Firebase Storage — images du site.
//
// Ce fichier manquait au dépôt : sans lui, le bucket refuse toute écriture et
// les écrans d'envoi n'expliquent rien à l'utilisateur. Les identifiants de
// rôle sont lus dans Firestore, exactement comme dans firestore.rules.
// ===========================================================================
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isOfficial() {
      return isAuth() && request.auth.uid == '9IzGlpp6DHhrN9GW72haeb869Om1';
    }

    function userRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isBureau() {
      return isAuth() && (isOfficial() || userRole() == 'bureau');
    }

    function isManagerPlus() {
      return isAuth() && (isOfficial() || userRole() in ['manager', 'bureau']);
    }

    // Image uniquement, taille bornée : le client compresse en JPEG avant
    // l'envoi (largeur max 800–2000 px). `request.resource` vaut null sur une
    // suppression, qui doit rester possible pour qui peut écrire.
    function isAllowedUpload() {
      return request.resource == null
        || (request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*'));
    }

    // Lecture publique : les visuels s'affichent sur le site public
    // (maillots, Adversaires, équipe, articles, médiathèque, chat).
    match /{allPaths=**} {
      allow read: if true;
    }

    // ----- Médiathèque, articles, matchs, adversaires : bureau uniquement -----
    match /media/{file} {
      allow write: if isBureau() && isAllowedUpload();
    }
    match /articles/{file} {
      allow write: if isBureau() && isAllowedUpload();
    }
    match /matches/{file} {
      allow write: if isBureau() && isAllowedUpload();
    }
    match /opponents/{file} {
      allow write: if isBureau() && isAllowedUpload();
    }
    match /uploads/{file} {
      allow write: if isBureau() && isAllowedUpload();
    }

    // ----- Fiche joueur : chacun écrit la sienne, le staff toutes -----
    match /players/{uid}/{file} {
      allow write: if isAllowedUpload() && (isManagerPlus() || (isAuth() && request.auth.uid == uid));
    }

    // ----- Avatar de profil : son propre dossier -----
    match /avatars/{uid}/{file} {
      allow write: if isAllowedUpload() && isAuth() && request.auth.uid == uid;
    }

    // ----- Images de discussion : tout membre connecté -----
    match /chat/{file} {
      allow write: if isAllowedUpload() && isAuth();
    }
  }
}